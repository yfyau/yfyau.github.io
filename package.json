{
  "name": "yfyau.github.io",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://jason.yfyau.com/",
  "dependencies": {
    "react": "16.9.0",
    "react-dom": "16.9.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "postbuild": "node scripts/prerender.js",
    "test": "vitest",
    "predeploy": "npm run verify",
    "deploy": "gh-pages -d build -b build",
    "test:ci": "vitest run",
    "verify:build": "node scripts/verify-build.js",
    "verify": "node scripts/verify.js",
    "lint": "npm run lint:eslint && npm run lint:ui",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:ui": "oxlint --config .oxlintrc.json --deny-warnings src"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "browserslist": "4.29.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "gh-pages": "6.3.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "oxlint": "1.89.0",
    "postcss": "8.5.31",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1"
}
